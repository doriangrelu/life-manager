<?xml version="1.0"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  Règles de lisibilité du backend (voir docs/architecture.md) :
  petites méthodes, petits fichiers, faible complexité. Pas de règles de mise en forme pure.
-->
<module name="Checker">
    <property name="severity" value="warning"/>

    <!-- Un fichier = une classe courte. -->
    <module name="FileLength">
        <property name="max" value="250"/>
    </module>

    <module name="TreeWalker">
        <!-- Méthodes courtes (lignes vides et commentaires non comptés). -->
        <module name="MethodLength">
            <property name="max" value="25"/>
            <property name="countEmpty" value="false"/>
        </module>
        <module name="CyclomaticComplexity">
            <property name="max" value="10"/>
        </module>
        <module name="NPathComplexity">
            <property name="max" value="50"/>
        </module>
        <module name="NestedIfDepth">
            <property name="max" value="2"/>
        </module>
        <module name="ParameterNumber">
            <property name="max" value="5"/>
            <!-- Les records portent leurs champs en paramètres : pas de limite pour eux. -->
            <property name="tokens" value="METHOD_DEF"/>
        </module>

        <!-- Hygiène de base. -->
        <module name="AvoidStarImport"/>
        <module name="UnusedImports"/>
        <module name="NeedBraces"/>
        <module name="EmptyCatchBlock"/>
        <module name="MissingSwitchDefault"/>
    </module>
</module>
