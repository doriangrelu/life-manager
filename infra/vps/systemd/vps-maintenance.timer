[Unit]
Description=Maintenance nocturne du VPS chaque nuit

[Timer]
# Heure du serveur (UTC), comme la sauvegarde (3 h) et la mise à jour de Keycloak (4 h 15) qu'elle suit :
# 6 h à Paris en hiver, 7 h en été.
OnCalendar=*-*-* 05:00:00 UTC
# Serveur éteint à l'heure prévue : la maintenance part au démarrage suivant.
Persistent=true

[Install]
WantedBy=timers.target
